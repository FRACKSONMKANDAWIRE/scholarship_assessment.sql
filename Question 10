-- ---------------------------------------------------------------------
-- (e) View [5 marks]
-- APPROVED only; household income is not exposed.
-- ---------------------------------------------------------------------
CREATE OR REPLACE VIEW v_approved_applicants AS
SELECT a.application_id,
       s.student_number,
       s.full_name,
       a.average_mark,
       a.status
FROM applications a
JOIN students s ON s.student_id = a.student_id
WHERE a.status = 'APPROVED';

-- ---------------------------------------------------------------------
-- (f) Index [5 marks]
-- Composite B-tree: status (equality) first, submitted_on (range)
-- second. "PENDING applications submitted between two dates" reads one
-- contiguous slice of the index.
-- ---------------------------------------------------------------------
CREATE INDEX idx_applications_status_submitted ON applications (status, submitted_on);
ANALYZE applications;

SET enable_seqscan = off;   -- demo only: tiny table would otherwise use Seq Scan
