-- ---------------------------------------------------------------------
-- (g) Scheduled job [6 marks]
-- The FOR loop selects PENDING rows only, so completed applications are
-- never reassessed and a rerun creates no extra audit entries.
-- ---------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE pr_assess_pending()
LANGUAGE plpgsql
AS $$
DECLARE
    r RECORD;
BEGIN
    FOR r IN
        SELECT application_id
        FROM applications
        WHERE status = 'PENDING'
        ORDER BY submitted_on, application_id
    LOOP
        CALL pr_assess_application(r.application_id);
    END LOOP;
END;
$$;

CALL pr_assess_pending();   -- assesses applications 2-6
CALL pr_assess_pending();   -- rerun: nothing PENDING, nothing changes

